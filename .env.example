# Django Core Settings
SECRET_KEY=django-insecure-ai-learning-journal-system-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://www.alittlewonder.com
USE_SQLITE=False

# 資料庫連線設定 (PostgreSQL)
DB_ENGINE=postgresql
DB_NAME=alw_journal
DB_USER=journal_user
DB_PASSWORD=journal_pass_secure_2026
DB_HOST=host.docker.internal
DB_PORT=5432

# Google OAuth 2.0 Settings (Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/accounts/google/callback/

# Google Gemini API Settings
GEMINI_API_KEY=your-google-gemini-api-key
