msgstr "River of Traces"

msgid "漫步翻看時間河流裡的每日痕跡"
msgstr "Wander through daily traces in the river of time"

msgid "手帳音效：翻頁、書寫、蓋印"
msgstr "Handbook Sound: Page flip, writing, stamping"

msgid "音效"
msgstr "Sound"

msgid "方向："
msgstr "Focus: "

msgid "更換前進方向"
msgstr "Change focus direction"

msgid "點擊鉛筆隨時更換前進方向"
msgstr "Click pencil to change focus direction anytime"

msgid "當前專注方向，點擊鉛筆可更換"
msgstr "Current focus direction, click pencil to change"

